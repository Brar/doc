{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Npgsql/src/Npgsql/bin/Release/net7.0/Npgsql.dll",
            "Npgsql/src/Npgsql.DependencyInjection/bin/Release/netstandard2.0/Npgsql.DependencyInjection.dll",
            "Npgsql/src/Npgsql.Json.NET/bin/Release/netstandard2.0/Npgsql.Json.NET.dll",
            "Npgsql/src/Npgsql.OpenTelemetry/bin/Release/netstandard2.0/Npgsql.OpenTelemetry.dll",
            "Npgsql/src/Npgsql.NodaTime/bin/Release/net6.0/Npgsql.NodaTime.dll",
            "Npgsql/src/Npgsql.GeoJSON/bin/Release/netstandard2.0/Npgsql.GeoJSON.dll",
            "Npgsql/src/Npgsql.NetTopologySuite/bin/Release/netstandard2.0/Npgsql.NetTopologySuite.dll"
          ]
        }
      ],
      "dest": "obj/api/Npgsql"
    },
    {
      "src": [
        {
          "files": [
            "efcore.pg/src/EFCore.PG/bin/Release/net7.0/Npgsql.EntityFrameworkCore.PostgreSQL.dll",
            "efcore.pg/src/EFCore.PG.NodaTime/bin/Release/net6.0/Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime.dll",
            "efcore.pg/src/EFCore.PG.NTS/bin/Release/net6.0/Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite.dll"
          ]
        }
      ],
      "dest": "obj/api/EFCore.PG"
    }
  ],
  "build": {
    "template": [
        "default",
        "modern",
        "template"
    ],
    "content": [
      {
        "files": [ "**/*.yml" ],
        "cwd": "obj/api/Npgsql",
        "dest": "doc/api"
      },
      {
        "files": [ "**/*.yml" ],
        "cwd": "obj/api/EFCore.PG",
        "dest": "efcore/api"
      },
      {
        "files": [ "**.md", "toc.yml" ],
        "cwd": "conceptual/Npgsql",
        "dest": "doc"
      },
      {
        "files": [ "**.md", "toc.yml" ],
        "cwd": "conceptual/EFCore.PG",
        "dest": "efcore"
      },
      {
        "files": [ "**.md", "toc.yml" ],
        "cwd": "conceptual/EF6.PG",
        "dest": "ef6"
      },
      {
        "files": [ "*.md", "dev/**.md", "toc.yml" ]
      }
    ],
    "resource": [
      {
        "files": [ "img/**", "styles/**", "CNAME" ]
      },
      {
        "files": [ "**" ],
        "src": "favicons"
      }
    ],
    "xrefService": [ "https://xref.docs.microsoft.com/query?uid={uid}" ],
    "globalMetadata": {
      "_appTitle": "Npgsql Documentation",
      "_appFooter": "© Copyright 2023 The Npgsql Development Team",
      "_enableSearch": true,
      "_gitContribute": {
        "branch": "main"
      }
    },
    "fileMetadata": {
      "_gitContribute" : {
        "obj/api/Npgsql/**.yml": {
          "repo": "https://github.com/npgsql/Npgsql",
          "branch": "stable"
        },
        "obj/api/EFCore.PG/**.yml": {
          "repo": "https://github.com/npgsql/Npgsql.EntityFrameworkCore.PostgreSQL",
          "branch": "stable"
        }
      }
    },
    "dest" : "live"
  }
}
